# Svart configuration. Everything is optional: with no settings at all Svart
# starts, prints a one-time setup token in its log, and the setup page walks
# you through the rest. Copy to .env and uncomment what you need.

# --- Listeners ---------------------------------------------------------------
# DNS_PORT=5353              # UDP+TCP DNS port inside the process/container
# DNS_PUBLISHED_PORT=53      # port devices actually use, if a container maps it (setup page hint)
# ADMIN_PORT=3000            # web UI and API
# EXTERNAL_IP=               # this host's LAN IP; shown on the setup page, used for 127.0.0.1 remapping

# --- Storage -----------------------------------------------------------------
# DB_PATH=./svart-dns.db     # SQLite database (config + last 8 days of queries)
# ARCHIVE_PATH=./archives    # Parquet archives of older queries

# --- Analysis ranking data ----------------------------------------------------
# TOP_SITES_PATH=./data/top-sites.csv  # optional local rank,domain CSV; see docs/configuration.md

# --- First administrator -------------------------------------------------------
# Leave unset to use the setup page. Set both to create the admin without it
# (automation); the password is only read when no admin exists yet.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# --- Who may use this resolver -------------------------------------------------
# Default: loopback, RFC 1918, 100.64.0.0/10 (CGNAT/Tailscale), link-local and
# fc00::/7. Everyone else gets REFUSED, so an exposed port is not an open resolver.
# ALLOWED_CLIENTS=192.168.0.0/16,10.0.0.0/8,fd00::/8
# DNS_RATE_LIMIT_QPS=0       # per /24 (IPv4) or /56 (IPv6); 0 = off
# DNS_TCP_MAX_CONNS=1000
# DNS_TCP_MAX_CONNS_PER_IP=32

# --- Resolver behavior ---------------------------------------------------------
# DNS_CACHE_SIZE_MB=64       # answer cache budget (~140k answers)
# DNS_REBIND_PROTECTION=false  # refuse public names that resolve to private addresses
# DNS_REBIND_ALLOW_DOMAINS=    # comma-separated exceptions (e.g. plex.direct)

# --- Blocklist downloads ---------------------------------------------------------
# ALLOW_PRIVATE_LIST_URLS=false  # allow list URLs on your own network (e.g. a local list server)
# LIST_MAX_DOWNLOAD_BYTES=268435456
# LIST_MAX_LINES=5000000

# --- Web UI hardening ------------------------------------------------------------
# TLS_CERT=                  # fullchain.pem; enables HTTPS for the web UI
# TLS_KEY=                   # privkey.pem
# ADMIN_ALLOWED_HOSTS=       # e.g. svart.home.arpa:3000; other Host headers are refused
# TRUST_PROXY_HEADERS=false  # trust X-Forwarded-Proto/-For from your reverse proxy

# --- Logs and metrics ------------------------------------------------------------
# LOG_FORMAT=json            # text or json
# LOG_LEVEL=info             # debug, info, warn, error
# LOG_QUERIES=false          # also write every query to the log (SQLite always has them)
# LOKI_URL=                  # push logs straight to Grafana Loki, e.g. http://loki:3100
# NODE_ID=                   # instance name in logs/metrics (default: hostname)
# METRICS_PER_CLIENT=false   # per-client Prometheus series (capped; aliases first)
# METRICS_CLIENT_LIMIT=256
# PPROF_ADDR=                # loopback-only Go profiler, e.g. 127.0.0.1:6060

# --- High availability (two or more nodes) ---------------------------------------------
# See docs/operations.md before enabling. Requires TLS on every node.
# PEERS=https://svart-b.example.lan:3000
# SYNC_PEER_ALLOWLIST=https://svart-a.example.lan:3000,https://svart-b.example.lan:3000
# SYNC_SECRET=               # at least 32 random bytes, same on every node
# SYNC_INTERVAL=2s
# SYNC_TLS_SERVER_NAME=      # certificate name when peer URLs are IP addresses
# TLS_CA=                    # CA for self-signed peer certificates
# SYNC_REPLICATE_IDENTITY=false  # also sync users and API tokens (read DD-029 first)

# Optional self-hosted control-plane traces and continuous profiles (disabled if unset)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# PYROSCOPE_SERVER_ADDRESS=http://alloy:9999
