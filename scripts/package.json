{
  "name": "svart-supporting-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check '*.mjs' '*.json' ../testdata/api-client-contract.ts '../tests/observability/*.{cjs,mjs}' 'e2e/*.ts'",
    "lint": "cd .. && scripts/node_modules/.bin/eslint --config scripts/eslint.config.mjs scripts testdata/api-client-contract.ts tests/observability --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "c8 --all --include='*.mjs' --exclude='*-test.mjs' --exclude='eslint.config.mjs' --check-coverage --lines=80 --functions=80 --branches=80 --statements=80 --reporter=text --reporter=json --reporter=lcov node --test '*-test.mjs'",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "c8": "12.0.0",
    "eslint": "10.8.0",
    "globals": "16.4.0",
    "playwright-core": "1.62.1",
    "prettier": "3.9.9",
    "typescript": "5.6.3",
    "typescript-eslint": "8.65.0"
  }
}
