# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Project artifacts
/svart-dns
svart-dns.db
server.log
data/
certs/

# Frontend
frontend/node_modules/
frontend/dist/
scripts/node_modules/
scripts/coverage/
.worktrees/
benchmarks/lists/
benchmarks/results/

# TypeScript incremental build cache
frontend/*.tsbuildinfo

# Python development tools and validation output
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
.coverage*
coverage-python.json
# Frontend test evidence is retained locally, not shipped.
frontend/coverage/

# Unique complete compiler coverage artifacts for each gate run
coverage-go/

# Supporting validation dependencies
scripts/node_modules

# Generated browser E2E bundle
scripts/e2e/main.mjs
